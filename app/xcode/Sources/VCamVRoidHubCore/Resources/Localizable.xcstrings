          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre no VRoid Hub para usar seus modelos e os modelos curtidos."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข้าสู่ระบบ VRoid Hub เพื่อใช้โมเดลของคุณและโมเดลที่คุณถูกใจ"
          }
