{
  "openrpc": "1.3.2",
  "info": {
    "title": "VCam RPC",
    "version": "0.1.0",
    "description": "The public JSON-RPC 2.0 API of VCam, served over a localhost WebSocket. Methods marked with the `Events` tag are notifications VCam pushes to subscribed clients (`x-direction: serverToClient`); subscribe to them with `events.subscribe`."
  },
  "methods": [
    {
      "name": "app.getInfo",
      "summary": "Returns the app version, API version, and capabilities",
      "paramStructure": "by-name",
      "params": [],
      "result": {
        "name": "info",
        "schema": {
          "type": "object",
          "required": [
            "apiVersion",
            "appVersion",
            "capabilities"
          ],
          "properties": {
            "apiVersion": {
              "type": "string",
              "description": "The version of this API specification."
            },
            "appVersion": {
              "type": "string",
              "description": "The version of the running VCam app."
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Feature areas this VCam build supports, e.g. \"vrma\" when VRMA motions are available."
            }
          }
        }
      }
    },
    {
      "name": "state.get",
      "summary": "Returns the current avatar, playing motions, and expression",
      "paramStructure": "by-name",
      "params": [],
      "result": {
        "name": "state",
        "schema": {
          "type": "object",
          "required": [
            "playingMotionIds"
          ],
          "properties": {
            "avatarId": {
              "type": "string",
              "format": "uuid",
              "description": "The last loaded avatar from the avatar library; absent when the current avatar was loaded directly from a file."
            },
            "playingMotionIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "expressionName": {
              "type": "string",
              "description": "The currently applied expression; absent when none is applied."
            }
          }
        }
      }
    },
    {
      "name": "avatar.list",
      "summary": "Lists the avatars registered in the avatar library",
      "paramStructure": "by-name",
      "params": [],
      "result": {
        "name": "avatars",
        "schema": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/Avatar"
          }
        }
      }
    },
    {
      "name": "avatar.load",
      "summary": "Loads an avatar from the avatar library",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "avatarId",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "result": {
        "name": "success",
        "schema": {
          "type": "boolean"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/avatarNotFound"
        }
      ]
    },
    {
      "name": "avatar.import.begin",
      "summary": "Starts uploading a VRM file to import into the avatar library",
      "description": "Returns an importId and prepares a staging area. Send the file content as WebSocket binary frames on the same connection: each frame is the 36-byte importId (its UUID string as ASCII) followed by a chunk of file data. Frames must not exceed 1 MiB in total. Finish with avatar.import.commit, or abort with avatar.import.cancel. Available only when app.getInfo lists the avatarImport capability.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "filename",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "The name of the uploaded file including the .vrm extension. Used as the default display name."
        }
      ],
      "result": {
        "name": "result",
        "schema": {
          "type": "object",
          "required": [
            "importId"
          ],
          "properties": {
            "importId": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/unsupportedOperation"
        },
        {
          "$ref": "#/components/errors/importFailed"
        }
      ]
    },
    {
      "name": "avatar.import.commit",
      "summary": "Registers the uploaded file to the avatar library",
      "description": "Validates the uploaded data as a VRM and registers it to the avatar library. The staging area is removed regardless of the outcome.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "importId",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "load",
          "schema": {
            "type": "boolean",
            "default": false
          },
          "description": "Loads the imported avatar immediately."
        }
      ],
      "result": {
        "name": "result",
        "schema": {
          "type": "object",
          "required": [
            "avatarId"
          ],
          "properties": {
            "avatarId": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/importNotFound"
        },
        {
          "$ref": "#/components/errors/invalidVrm"
        },
        {
          "$ref": "#/components/errors/importFailed"
        }
      ]
    },
    {
      "name": "avatar.import.cancel",
      "summary": "Aborts an upload and removes its staging area",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "importId",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "result": {
        "name": "success",
        "schema": {
          "type": "boolean"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/importNotFound"
        }
      ]
    },
    {
      "name": "expression.list",
      "summary": "Lists the expressions of the current avatar",
      "paramStructure": "by-name",
      "params": [],
      "result": {
        "name": "expressions",
        "schema": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/Expression"
          }
        }
      }
    },
    {
      "name": "expression.set",
      "summary": "Applies an expression to the current avatar",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "name",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "result": {
        "name": "success",
        "schema": {
          "type": "boolean"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/expressionNotFound"
        }
      ]
    },
    {
      "name": "motion.list",
      "summary": "Lists the available motions (built-in and imported)",
      "paramStructure": "by-name",
      "params": [],
      "result": {
        "name": "motions",
        "schema": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/Motion"
          }
        }
      }
    },
    {
      "name": "motion.play",
      "summary": "Plays a motion",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "motionId",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "loop",
          "schema": {
            "type": "boolean"
          },
          "description": "Overrides the motion's loop setting for this playback; the stored setting is used when omitted."
        }
      ],
      "result": {
        "name": "success",
        "schema": {
          "type": "boolean"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/motionNotFound"
        }
      ]
    },
    {
      "name": "motion.stop",
      "summary": "Stops a playing motion",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "motionId",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "result": {
        "name": "success",
        "schema": {
          "type": "boolean"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/motionNotFound"
        }
      ]
    },
    {
      "name": "scene.get",
      "summary": "Returns the current scene",
      "paramStructure": "by-name",
      "params": [],
      "result": {
        "name": "scene",
        "schema": {
          "$ref": "#/components/schemas/Scene"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/notReady"
        }
      ]
    },
    {
      "name": "scene.load",
      "summary": "Loads a scene",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "sceneId",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "result": {
        "name": "success",
        "schema": {
          "type": "boolean"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/sceneNotFound"
        },
        {
          "$ref": "#/components/errors/notReady"
        }
      ]
    },
    {
      "name": "camera.reset",
      "summary": "Resets the avatar and camera to the initial position",
      "paramStructure": "by-name",
      "params": [],
      "result": {
        "name": "success",
        "schema": {
          "type": "boolean"
        }
      }
    },
    {
      "name": "subtitle.set",
      "summary": "Shows text as the subtitle",
      "description": "Replaces the subtitle with the given text. The subtitle keeps the style and placement configured in the app, and is shared by every scene. Passing an empty string is the same as subtitle.clear.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "text",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "result": {
        "name": "success",
        "schema": {
          "type": "boolean"
        }
      }
    },
    {
      "name": "subtitle.clear",
      "summary": "Hides the subtitle",
      "paramStructure": "by-name",
      "params": [],
      "result": {
        "name": "success",
        "schema": {
          "type": "boolean"
        }
      }
    },
    {
      "name": "pose.open",
      "summary": "Opens the pose editor with the current avatar",
      "description": "Opens the pose editor window, or fronts it when it is already open, and loads the current avatar into it. The other pose methods require the editor to be open. Bone names follow VRM 1.0 (`hips`, `spine`, `leftUpperArm`, ...); rotations are degrees relative to the rest pose (T-pose), applied in Y, X, Z order around the bone's own axes, so `[0, 0, 0]` is the rest pose. Expressions are named as VRM 1.0 names its presets (`happy`, `blink`, ...) and as the model names its custom expressions; weights run from 0 to 1. Available only when app.getInfo lists the poseEditor capability.",
      "paramStructure": "by-name",
      "params": [],
      "result": {
        "name": "result",
        "schema": {
          "type": "object",
          "required": [
            "bones",
            "expressions"
          ],
          "properties": {
            "bones": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "The humanoid bones the avatar has, in VRM order."
            },
            "expressions": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "The expressions the avatar has: presets first, then custom expressions."
            }
          }
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/notReady"
        },
        {
          "$ref": "#/components/errors/unsupportedOperation"
        }
      ]
    },
    {
      "name": "pose.get",
      "summary": "Returns the pose being edited",
      "paramStructure": "by-name",
      "params": [],
      "result": {
        "name": "joints",
        "schema": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/JointPose"
          }
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/poseEditorNotOpen"
        }
      ]
    },
    {
      "name": "pose.set",
      "summary": "Poses bones in the editor",
      "description": "Applies the given bones as one undoable change. `position` is accepted for `hips` only.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "joints",
          "required": true,
          "schema": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JointPose"
            }
          },
          "description": "The bones to pose. Bones not listed keep their current pose."
        }
      ],
      "result": {
        "name": "success",
        "schema": {
          "type": "boolean"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/poseEditorNotOpen"
        },
        {
          "$ref": "#/components/errors/boneNotFound"
        }
      ]
    },
    {
      "name": "pose.reset",
      "summary": "Returns bones to the rest pose",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "bones",
          "schema": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "The bones to reset. Omit to reset every bone."
        }
      ],
      "result": {
        "name": "success",
        "schema": {
          "type": "boolean"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/poseEditorNotOpen"
        },
        {
          "$ref": "#/components/errors/boneNotFound"
        }
      ]
    },
    {
      "name": "pose.expressions.get",
      "summary": "Returns the expression weights being edited",
      "paramStructure": "by-name",
      "params": [],
      "result": {
        "name": "expressions",
        "schema": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/ExpressionWeight"
          }
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/poseEditorNotOpen"
        }
      ]
    },
    {
      "name": "pose.expressions.set",
      "summary": "Weights expressions in the editor",
      "description": "Applies the given weights as one undoable change. Expressions not listed keep their current weight.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "expressions",
          "required": true,
          "schema": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExpressionWeight"
            }
          },
          "description": "The expressions to weight."
        }
      ],
      "result": {
        "name": "success",
        "schema": {
          "type": "boolean"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/poseEditorNotOpen"
        },
        {
          "$ref": "#/components/errors/expressionNotFound"
        }
      ]
    },
    {
      "name": "pose.expressions.reset",
      "summary": "Takes expressions off",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "names",
          "schema": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "The expressions to take off. Omit to take off every expression."
        }
      ],
      "result": {
        "name": "success",
        "schema": {
          "type": "boolean"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/poseEditorNotOpen"
        },
        {
          "$ref": "#/components/errors/expressionNotFound"
        }
      ]
    },
    {
      "name": "pose.apply",
      "summary": "Plays the pose on the live avatar",
      "description": "Shows the pose on the avatar in the main window as a looping motion, replacing a pose applied earlier. Stop it with motion.stop on the motion ID reported by motion.started, or by closing the editor.",
      "paramStructure": "by-name",
      "params": [],
      "result": {
        "name": "success",
        "schema": {
          "type": "boolean"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/poseEditorNotOpen"
        }
      ]
    },
    {
      "name": "pose.export",
      "summary": "Returns the pose as a VRM animation",
      "description": "Writes the pose as a `.vrma` (VRMC_vrm_animation) clip that holds it for `duration` seconds, with the expressions worn (weight above 0) written into it, and returns the file as base64.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "name",
          "schema": {
            "type": "string"
          },
          "description": "The animation's name inside the file."
        },
        {
          "name": "duration",
          "schema": {
            "type": "number",
            "minimum": 0
          },
          "description": "Seconds the clip holds the pose. Defaults to 2."
        }
      ],
      "result": {
        "name": "result",
        "schema": {
          "type": "object",
          "required": [
            "vrma"
          ],
          "properties": {
            "vrma": {
              "type": "string",
              "description": "The .vrma file, base64-encoded."
            }
          }
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/poseEditorNotOpen"
        }
      ]
    },
    {
      "name": "pose.saveAsMotion",
      "summary": "Adds the pose to the motion library",
      "description": "Registers the pose as an imported motion holding it for `duration` seconds, so motion.play and the toolbar can play it.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "name",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "The display name in the motion list."
        },
        {
          "name": "duration",
          "schema": {
            "type": "number",
            "minimum": 0
          },
          "description": "Seconds the clip holds the pose. Defaults to 2."
        },
        {
          "name": "loop",
          "schema": {
            "type": "boolean"
          },
          "description": "The motion's loop setting. Defaults to false."
        }
      ],
      "result": {
        "name": "result",
        "schema": {
          "type": "object",
          "required": [
            "motionId"
          ],
          "properties": {
            "motionId": {
              "type": "string"
            }
          }
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/poseEditorNotOpen"
        },
        {
          "$ref": "#/components/errors/importFailed"
        }
      ]
    },
    {
      "name": "pose.close",
      "summary": "Closes the pose editor",
      "paramStructure": "by-name",
      "params": [],
      "result": {
        "name": "success",
        "schema": {
          "type": "boolean"
        }
      },
      "errors": []
    },
    {
      "name": "events.subscribe",
      "summary": "Subscribes this connection to server-pushed events",
      "description": "Connections receive no events until they subscribe. Omit `events` to subscribe to all events.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "events",
          "schema": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "Event method names to receive, e.g. [\"motion.started\"]. Omit to receive all events."
        }
      ],
      "result": {
        "name": "success",
        "schema": {
          "type": "boolean"
        }
      }
    },
    {
      "name": "rpc.discover",
      "summary": "Returns the OpenRPC document describing this API",
      "paramStructure": "by-name",
      "params": [],
      "result": {
        "name": "openrpcDocument",
        "schema": {
          "type": "object"
        }
      }
    },
    {
      "name": "avatar.loaded",
      "summary": "An avatar has been loaded",
      "x-direction": "serverToClient",
      "tags": [
        {
          "name": "Events"
        }
      ],
      "paramStructure": "by-name",
      "params": [
        {
          "name": "avatarId",
          "schema": {
            "type": "string",
            "format": "uuid"
          },
          "description": "Absent when the avatar was loaded directly from a file instead of the avatar library."
        }
      ]
    },
    {
      "name": "motion.started",
      "summary": "A motion has started playing",
      "x-direction": "serverToClient",
      "tags": [
        {
          "name": "Events"
        }
      ],
      "paramStructure": "by-name",
      "params": [
        {
          "name": "motionId",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    {
      "name": "motion.stopped",
      "summary": "A motion has stopped playing",
      "x-direction": "serverToClient",
      "tags": [
        {
          "name": "Events"
        }
      ],
      "paramStructure": "by-name",
      "params": [
        {
          "name": "motionId",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    {
      "name": "expression.changed",
      "summary": "The applied expression has changed",
      "x-direction": "serverToClient",
      "tags": [
        {
          "name": "Events"
        }
      ],
      "paramStructure": "by-name",
      "params": [
        {
          "name": "name",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    {
      "name": "scene.loaded",
      "summary": "A scene has been loaded",
      "x-direction": "serverToClient",
      "tags": [
        {
          "name": "Events"
        }
      ],
      "paramStructure": "by-name",
      "params": [
        {
          "name": "sceneId",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ]
    },
    {
      "name": "subtitle.changed",
      "summary": "The subtitle text has changed",
      "x-direction": "serverToClient",
      "tags": [
        {
          "name": "Events"
        }
      ],
      "paramStructure": "by-name",
      "params": [
        {
          "name": "text",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    }
  ],
  "components": {
    "schemas": {
      "Avatar": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Expression": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "Motion": {
        "type": "object",
        "required": [
          "id",
          "name",
          "isLoop"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "A stable motion ID: \"builtin:<name>\" or \"vrma:<UUID>\"."
          },
          "name": {
            "type": "string"
          },
          "isLoop": {
            "type": "boolean",
            "description": "The motion's current loop setting."
          }
        }
      },
      "Scene": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "JointPose": {
        "type": "object",
        "required": [
          "name",
          "rotation"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "A VRM 1.0 humanoid bone name."
          },
          "rotation": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
