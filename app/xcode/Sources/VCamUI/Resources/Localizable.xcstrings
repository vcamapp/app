    "cameraExtensionAwaitingUserApproval": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The virtual camera is not allowed. Please allow it from the 'Login Items & Extensions' of 'General' section in the settings app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仮想カメラが許可されていません。設定アプリの「一般」→「ログイン項目と拡張機能」から許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가상 카메라가 허용되지 않았습니다. 설정 앱의 '일반' → '로그인 항목 및 확장 프로그램'에서 허용해 주세요."
          }
        }
      }
