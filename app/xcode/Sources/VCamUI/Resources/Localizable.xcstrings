    "vrmaRequiresVRM1Message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To play a VRMA, this model must be reloaded as VRM 1.0 using automatic conversion. Enable the setting and reload the model."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VRMAを再生するには、このモデルをVRM 1.0へ自動変換して読み込む必要があります。設定を有効にしてモデルを再読み込みしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "VRMA를 재생하려면 이 모델을 VRM 1.0으로 자동 변환하여 불러와야 합니다. 설정을 활성화한 후 모델을 다시 불러와 주세요."
          }
        }
      }
